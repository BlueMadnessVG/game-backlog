# Server environment
APP_ENV=development
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/backlog_db
PORT=3000
ENABLE_ANALYTICS=true

# Auth
# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Game platform providers
STEAM_API_KEY=your_steam_api_key
OPENXBL_API_KEY=your_openxbl_api_key

# Cover enrichment (IGDB)
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret