  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@hono/valibot-validator": "^0.6.1",
    "@repo/shared": "workspace:*",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.9",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "psn-api": "^2.18.0",
    "valibot": "^1.3.1"
