{
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "pattern": "./apps/*/" },
    { "pattern": "./packages/*/" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "cSpell.words": [
    "colour",
    "fract",
    "frameloop",
    "gamerscore",
    "glsl",
    "picklist",
    "scanline",
    "Scanlines",
    "Statcard",
    "Statscard"
  ]
}
